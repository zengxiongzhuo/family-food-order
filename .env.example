# Environment Variables

# Database (Vercel Postgres / Neon)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth
# Generate hash: node -e "const bcrypt=require('bcryptjs');bcrypt.hash('your-password',10).then(h=>console.log(h))"
ADMIN_PASSWORD_HASH=""
JWT_SECRET="change-this-to-a-random-string"

# Vercel Blob (auto-provided when connected via Vercel dashboard)
BLOB_READ_WRITE_TOKEN=""

# WxPusher (微信推送通知)
# 从 https://wxpusher.zjiecode.com 获取
WXPUSHER_APP_TOKEN=""
WXPUSHER_UID=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
